# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_2="MY_SECOND_GEMINI_API_KEY"
GEMINI_API_KEY_3="MY_THIRD_GEMINI_API_KEY"
GEMINI_API_KEY_4="MY_FOURTH_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# Authentication hardening
# Set AUTH_SECRET to a long random value in Vercel. If omitted, the server derives
# an isolated authentication key from GEMINI_API_KEY for deployment compatibility.
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional override. Store the SHA-256 hash only; never put raw admin credentials in source.
QADA_ADMIN_CREDENTIAL_HASH_V4="SHA256_OF_ADMIN_CODE_COLON_PASSWORD"
ADMIN_DISPLAY_NAME="مدير النظام"
ADMIN_EMAIL="admin@example.invalid"
ADMIN_AGENCY="إدارة أصول القضاء"
