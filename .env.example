# QADA — required runtime configuration

# AI providers
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
AI_GATEWAY_API_KEY=""

# Public application URL
APP_URL="http://localhost:3000"

# Authentication
# Required in production. Use a random secret of at least 32 characters.
# Never derive or reuse this value from an AI provider key.
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Required in production and intentionally separate from AUTH_SECRET.
# Encrypts accounts, case records and admin analysis history at rest.
DATA_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Required in production for Administration login.
# SHA-256 of: ADMIN_CODE:ADMIN_PASSWORD
# Never commit the real hash or raw credentials.
QADA_ADMIN_CREDENTIAL_HASH_V7="SHA256_OF_ADMIN_CODE_COLON_PASSWORD"
ADMIN_DISPLAY_NAME="مدير النظام"
ADMIN_EMAIL="admin@example.invalid"
ADMIN_AGENCY="إدارة أصول القضاء"

# Direct test/guest access is fail-closed. Keep false on any public Railway/Vercel environment.
QADA_OPEN_TEST_MODE="false"
QADA_GUEST_ACCESS="false"

# Persistent store and distributed rate limiting.
# Use either a standard Redis connection string (Railway/private Redis) OR Upstash REST.
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QADA_REDIS_PREFIX="qada:v1"

# Local runtime
PORT="3000"
