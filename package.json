{
  "name": "qada",
  "private": true,
  "version": "0.0.0",
  "description": "QADA — Osool Al-Qadaa Saudi legal multi-agent platform",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run verify && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:legal-sources": "tsx scripts/smoke-legal-source-agents.ts",
    "test:legal-guard": "tsx scripts/smoke-legal-citation-guard.ts",
    "test:legal-ui-safety": "tsx scripts/smoke-legal-ui-safety.ts",
    "test:api-auth": "tsx scripts/smoke-api-auth.ts",
    "test:auth-consistency": "tsx scripts/smoke-auth-consistency.ts",
    "test:privacy-storage": "tsx scripts/smoke-privacy-storage.ts",
    "test:multimodal-evidence": "tsx scripts/smoke-multimodal-evidence.ts",
    "test:production-readiness": "tsx scripts/smoke-production-readiness.ts",
    "test:blueprint-map": "tsx scripts/smoke-blueprint-map.ts",
    "test:interaction-wiring": "tsx scripts/smoke-interaction-wiring.ts",
    "test:serverless-runtime": "tsx scripts/smoke-serverless-runtime.ts",
    "test:ai-runtime": "tsx scripts/smoke-ai-runtime.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "release:check": "tsx scripts/check-launch-blockers.ts",
    "verify": "npm run lint && npm run test:legal-sources && npm run test:legal-guard && npm run test:legal-ui-safety && npm run test:api-auth && npm run test:auth-consistency && npm run test:privacy-storage && npm run test:multimodal-evidence && npm run test:production-readiness && npm run test:blueprint-map && npm run test:interaction-wiring && npm run test:ui-luxury && npm run test:ui-8k && npm run test:sentinel && npm run test:claim-liberation && npm run test:conversation-state && npm run test:release-gate-grounding && npm run test:serverless-runtime && npm run test:security-hardening && npm run test:security-007 && npm run test:virtual-judge-gate && npm run test:agent-contracts && npm run test:agent-scenarios && npm run test:stress-agent-contracts && npm run test:stress-legal-workflows && npm run test:stress-source-agents && npm run test:turki-case",
    "test:turki-case": "tsx scripts/smoke-turki-case.ts",
    "test:security-hardening": "tsx scripts/smoke-security-hardening.ts",
    "test:security-007": "tsx scripts/security-007-audit.ts",
    "test:virtual-judge-gate": "tsx scripts/smoke-virtual-judge-gate.ts",
    "test:agent-contracts": "tsx scripts/smoke-agent-contracts.ts",
    "test:agent-scenarios": "tsx scripts/smoke-agent-scenarios.ts",
    "test:conversation-state": "tsx scripts/smoke-conversation-state.ts",
    "test:release-gate-grounding": "tsx scripts/smoke-release-gate-grounding.ts",
    "test:stress-agent-contracts": "tsx scripts/stress-agent-contracts-1000.ts",
    "test:stress-legal-workflows": "tsx scripts/stress-legal-workflows.ts",
    "test:stress-source-agents": "tsx scripts/stress-source-agents-1000.ts",
    "test:sentinel": "tsx scripts/smoke-sentinel.ts",
    "test:claim-liberation": "tsx scripts/smoke-claim-liberation.ts",
    "test:ui-luxury": "tsx scripts/smoke-ui-luxury.ts",
    "test:ui-8k": "tsx scripts/smoke-ui-8k.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^13.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^59.20.0",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "22.x"
  }
}
